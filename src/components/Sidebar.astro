---
import { getDocLookups, mobileSidebarsUrl, transformItems } from '../utils/sidebars';
import SidebarItem from './SidebarItem.astro';
import PlatformSwitcher from './PlatformSwitcher.astro';
import MobileSectionSwitcher from './MobileSectionSwitcher.astro';
import platformsData from '../data/platforms.json';

interface Props {
  sidebarData: any[];
  apiSidebarData?: any[];
  currentPlatformId: string;
  currentSlug: string;
  currentLocale?: string;
}

const { sidebarData, apiSidebarData, currentPlatformId, currentSlug, currentLocale } = Astro.props;

// Logic to determine active ID from slug (simplified: last part of slug matches id)
const activeId = currentSlug.split('/').pop() || ''; 

const lookups = await getDocLookups();
const processedSidebar = transformItems(sidebarData, lookups);
const processedApiSidebar = apiSidebarData ? transformItems(apiSidebarData, lookups) : null;

// Determine which top-level section the current page belongs to
const sdkIds = new Set(platformsData.sdkPlatforms.map((p: any) => p.id));
const currentSectionId: 'tutorial' | 'sdk' | 'api' =
    currentPlatformId === 'tutorial' ? 'tutorial'
    : currentPlatformId === 'api' ? 'api'
    : 'sdk';
const effectivePlatformId = sdkIds.has(currentPlatformId) ? currentPlatformId : 'ios';

// On API ref pages, scope the persist key per-spec so cross-spec navigation
// re-renders the sidebar instead of holding the stale operations list. Within
// a single spec (e.g. between operation pages), the key matches and persist
// keeps the same DOM — no flicker, no re-render.
const persistKey = currentPlatformId === 'api'
    ? `sidebar-api-${currentSlug.split('/')[0]}-${currentLocale ?? 'en'}`
    : `sidebar-${currentPlatformId}-${currentLocale ?? 'en'}`;
---

<aside
    id="main-sidebar"
    class="sidebar-main"
    data-platform-id={currentPlatformId}
    transition:persist={persistKey}
    transition:name="docs-sidebar"
>
    <MobileSectionSwitcher
        currentSectionId={currentSectionId}
        currentPlatformId={effectivePlatformId}
        currentSlug={currentSlug}
        sidebarsUrl={mobileSidebarsUrl(currentLocale)}
        sdkPlatforms={platformsData.sdkPlatforms}
        currentLocale={currentLocale}
    />

    <!-- Desktop-only: PlatformSwitcher dropdown -->
    <div class="px-6 pb-3 mb-2 lg:mt-0 mt-8 hidden lg:block">
        {platformsData.sdkPlatforms.some((p: any) => p.id === currentPlatformId) && (
            <div class="mb-1.5">
                <PlatformSwitcher
                    currentPlatformId={currentPlatformId}
                    currentActiveId={activeId}
                    currentLocale={currentLocale}
                />
            </div>
        )}
    </div>

    <!-- Desktop-only: main nav tree -->
    <nav class="sidebar-tree px-3 hidden lg:block" aria-label="Sidebar">
        <!-- One arrow shape, which every category's toggle references with <use> -->
        <svg width="0" height="0" style="position: absolute" aria-hidden="true">
            <symbol id="sidebar-chevron" viewBox="0 0 24 24">
                <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </symbol>
        </svg>
        <ul class="space-y-1">
          {processedSidebar.map((item) => (
            <SidebarItem item={item} activeId={activeId} />
          ))}
        </ul>

        {processedApiSidebar && processedApiSidebar.length > 0 && (
            <div class="api-sub-sidebar" aria-label="API reference navigation">
                <ul class="space-y-1">
                  {processedApiSidebar.map((item) => (
                    <SidebarItem item={item} activeId={activeId} />
                  ))}
                </ul>
            </div>
        )}
    </nav>
    
    <script>
      let hasScrolledToActive = false;

      function getLocaleFromPath(path: string) {
        const m = path.match(/^(.*\/docs\/)([a-z]{2})\//);
        return m ? { locale: m[2], base: m[1] } : null;
      }

      // Rewrite sidebar link hrefs to include (or strip) the current locale prefix
      function updateSidebarLinks() {
        const localeInfo = getLocaleFromPath(window.location.pathname);
        document.querySelectorAll('[data-sidebar-link]').forEach(el => {
          const baseHref = el.getAttribute('data-href');
          if (!baseHref) return;
          el.setAttribute(
            'href',
            localeInfo
              ? baseHref.replace(/^(.*\/docs\/)/, `$1${localeInfo.locale}/`)
              : baseHref
          );
        });
      }

      function updateActiveState() {
        // Strip locale prefix so sidebar links always match English data-href values.
        // Handles both /docs/zh/article and the locale root /docs/zh/ → /docs/
        const currentPath = window.location.pathname
          .replace(/\/$/, '')
          .replace(/^(.*\/docs)\/[a-z]{2}(\/|$)/, '$1$2')
          .replace(/\/$/, '') || '/';
        const links = document.querySelectorAll('[data-sidebar-link]');

        links.forEach(link => {
          const href = link.getAttribute('data-href')?.replace(/\/$/, '') || '/';
          const isActive = href === currentPath;

          // Overview links (spec landing pages) opt out of the standard
          // sidebar-item-bg-active treatment in favor of their own neutral
          // card style, so we toggle a different class on the link itself.
          if (link.hasAttribute('data-sidebar-overview-link')) {
            if (isActive) {
              link.classList.add('sidebar-overview-active');
              link.id = 'active-sidebar-item';
            } else {
              link.classList.remove('sidebar-overview-active');
              if (link.id === 'active-sidebar-item') link.id = '';
            }
            return;
          }

          const container = link.closest('[data-sidebar-container]');
          if (container) {
            if (isActive) {
              container.classList.add('sidebar-item-bg-active', 'sidebar-item-active');
              container.classList.remove('sidebar-item-hover', 'sidebar-item-primary', 'sidebar-item-secondary');
              container.id = 'active-sidebar-item';
            } else {
              container.classList.remove('sidebar-item-bg-active', 'sidebar-item-active');
              container.classList.add('sidebar-item-hover');
              if (container.id === 'active-sidebar-item') container.id = '';
            }
          }
        });
      }

      function scrollToActiveOnce() {
        if (!hasScrolledToActive) {
          const activeItem = document.getElementById('active-sidebar-item');
          if (activeItem) {
            setTimeout(() => {
              activeItem.scrollIntoView({ block: 'center', behavior: 'auto' });
            }, 250);
            hasScrolledToActive = true;
          }
        }
      }

      document.addEventListener('astro:page-load', () => {
        updateSidebarLinks();
        updateActiveState();
        scrollToActiveOnce();
      });

      // Initial execution
      updateSidebarLinks();
      updateActiveState();
      scrollToActiveOnce();
    </script>
</aside>

<style>
  .sidebar-main {
    position: fixed;
    inset: 0;
    top: 64px;
    left: 0;
    right: auto;
    z-index: 60;
    width: 18rem;
    background: var(--bg-primary);
    overflow-y: auto;
    padding-bottom: 2.5rem;
    padding-top: 1rem;
    transition: transform 0.3s, background-color 0.3s ease;
    transform: translateX(-100%);
    box-shadow: var(--shadow-lg);
    border-right: none;
  }

  @media (min-width: 1024px) {
    .sidebar-main {
      z-index: 10;
      transform: translateX(0);
      /* Position sidebar below the 64px header */
      top: 64px;
      /* Reset padding since the container is now moved down */
      padding-top: 1.5rem;
      box-shadow: none;
    }
  }

  /* API sub-sidebar: stacked below the platform sidebar on API reference pages.
     Reads as a distinct module while the platform sidebar above it provides
     collapsed background context. */
  .api-sub-sidebar {
    margin-top: 1rem;
    padding: 0.625rem 0.5rem 0.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: 0.625rem;
  }

  .api-sub-sidebar > * {
    margin-top: 0;
  }
</style>
