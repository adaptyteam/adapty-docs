---
// A static transcript of a coding-agent session, styled like a terminal
// agent (Claude Code, Codex) and framed like a code block.
// Articles fill it with <ChatTurn> children:
//
//   <AgentChat title="growth-advisor" caption="Example conversation with a sample app">
//   <ChatTurn role="user">Audit my app.</ChatTurn>
//   <ChatTurn role="tool" summary="Ran 7 read-only commands">…</ChatTurn>
//   <ChatTurn role="agent">…markdown…</ChatTurn>
//   <ChatTurn role="confirm" summary="Create a flow copy?">…question, then a numbered list of options…</ChatTurn>
//   </AgentChat>
//
// The turns are ordinary MDX, so translation and the markdown export
// (scripts/generate-md.mjs) see them as prose.
interface Props {
  title?: string;
  caption?: string;
}

const { title = 'Agent session', caption } = Astro.props;
---

<figure class="agent-chat">
  <div class="agent-chat-bar">
    <span class="agent-chat-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="agent-chat-title">{title}</span>
  </div>
  <div class="agent-chat-body">
    <slot />
    <div class="agent-chat-input" aria-hidden="true">
      <span class="agent-chat-prompt">&gt;</span><span class="agent-chat-cursor"></span>
    </div>
    {caption && <figcaption class="agent-chat-caption">{caption}</figcaption>}
  </div>
</figure>

<style>
  .agent-chat {
    margin: 2rem 0;
    border: 1px solid var(--bg-code-border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-code);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
  }

  :global(.dark) .agent-chat {
    border-color: var(--border-primary);
  }

  /* Same title bar as `.code-block-wrapper[data-title]::before` in global.css */
  .agent-chat-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--bg-code-border);
    background: var(--bg-secondary);
  }

  :global(.dark) .agent-chat-bar {
    background: var(--bg-primary);
    border-color: var(--border-primary);
  }

  .agent-chat-dots {
    display: inline-flex;
    gap: 5px;
  }

  .agent-chat-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-secondary);
  }

  .agent-chat-title {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .agent-chat-body {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    padding: 1.25rem 1.25rem 0.875rem;
  }

  /* The empty input box a terminal agent leaves at the bottom */
  .agent-chat-input {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.25rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-secondary);
    border-radius: 6px;
    color: var(--text-tertiary);
  }

  .agent-chat-cursor {
    width: 0.55em;
    height: 1.15em;
    background: var(--text-tertiary);
    opacity: 0.6;
  }

  /* Reads as the agent's status line under the input box */
  .agent-chat-caption {
    margin-top: -0.625rem;
    padding: 0 0.75rem;
    font-size: 11px;
    color: var(--text-tertiary);
  }

  @media (max-width: 640px) {
    .agent-chat {
      font-size: 12px;
    }

    .agent-chat-body {
      padding: 1rem 0.875rem 0.75rem;
    }
  }
</style>
