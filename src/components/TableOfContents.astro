---
import { getUIStrings } from '../locales/ui-strings';

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
    currentLocale?: string;
}

const { headings, currentLocale } = Astro.props;
const t = getUIStrings(currentLocale).toc;

// Filter to h2 and h3 only for a clean TOC
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

<nav class="toc-nav hidden xl:block shrink-0">
    <h5 class="toc-title">{t.onThisPage}</h5>
    <div class="toc-body">
        <div class="toc-indicator" aria-hidden="true"></div>
        <ul class="space-y-3">
            {tocHeadings.map(h => (
                <li class:list={[{ 'pl-4': h.depth === 3 }]}>
                    <a
                        href={`#${h.slug}`}
                        class="toc-link"
                        data-slug={h.slug}
                    >
                        {h.text}
                    </a>
                </li>
            ))}
        </ul>
    </div>
    
    <script>
        // ---- Tab-aware TOC ----
        // Tag each TOC <li> with the tab (group + value) that contains its heading,
        // then show/hide based on the active tab. Listens to `tab-sync` events that
        // Tabs.astro dispatches on user interaction; reads initial state from the DOM.
        function tagTocItemsByTabs() {
            const article = document.querySelector('article');
            if (!article) return;
            document.querySelectorAll('.toc-nav li').forEach(li => {
                const link = li.querySelector('.toc-link');
                if (!link) return;
                const slug = link.getAttribute('data-slug');
                if (!slug) return;
                let heading;
                try {
                    heading = article.querySelector(`#${CSS.escape(slug)}`);
                } catch (_) {
                    return;
                }
                if (!heading) return;
                const tabItem = heading.closest('.tab-item');
                if (!tabItem) return;
                const tabContainer = tabItem.closest('.tabs-container');
                if (!tabContainer) return;
                const groupId = tabContainer.getAttribute('data-group-id');
                const value = tabItem.getAttribute('data-value');
                if (!groupId || !value) return;
                li.setAttribute('data-toc-tab-group', groupId);
                li.setAttribute('data-toc-tab-value', value);
            });
        }

        function applyTocTabFilter(groupId, activeValue) {
            document.querySelectorAll(`.toc-nav li[data-toc-tab-group="${groupId}"]`).forEach(li => {
                if (li.getAttribute('data-toc-tab-value') === activeValue) {
                    li.classList.remove('toc-tab-hidden');
                } else {
                    li.classList.add('toc-tab-hidden');
                }
            });
        }

        function syncTocWithActiveTabs() {
            document.querySelectorAll('article .tabs-container[data-group-id]').forEach(container => {
                const groupId = container.getAttribute('data-group-id');
                const activeButton = container.querySelector('[role="tablist"] .tab-button-active');
                if (!groupId || !activeButton) return;
                const value = activeButton.dataset.value;
                if (value) applyTocTabFilter(groupId, value);
            });
        }

        function initTocTabSync() {
            tagTocItemsByTabs();
            // rAF gives Tabs.astro time to set its initial `.tab-button-active` class
            requestAnimationFrame(syncTocWithActiveTabs);
        }

        if (!window.__tocTabSyncAttached) {
            window.__tocTabSyncAttached = true;
            window.addEventListener('tab-sync', (e) => {
                if (e.detail && e.detail.groupId && e.detail.value) {
                    applyTocTabFilter(e.detail.groupId, e.detail.value);
                }
            });
        }

        initTocTabSync();
        document.addEventListener('astro:page-load', initTocTabSync);
        // ---- /Tab-aware TOC ----

        function initTOC() {
            const headings = Array.from(document.querySelectorAll('article h2, article h3'));
            if (headings.length === 0) return;

            let currentRangeKey = '';
            let isScrollingFromClick = false; // Flag to prevent updates during programmatic scroll

            // Highlight the RANGE of sections currently in the viewport: color their
            // links and stretch the rail indicator to cover them (it can span several
            // sections at once).
            function setActiveRange(ids) {
                const key = ids.join('|');
                const keyChanged = currentRangeKey !== key;
                if (keyChanged) {
                    currentRangeKey = key;
                    document.querySelectorAll('.toc-link').forEach(l => {
                        l.classList.toggle('toc-active', ids.includes(l.getAttribute('data-slug')));
                    });
                }
                // Geometry recomputes unconditionally: the nav may have just become
                // visible (viewport resize) or links may have moved (tab filtering).

                const body = document.querySelector('.toc-body');
                const indicator = document.querySelector('.toc-indicator');
                const links = ids
                    .map(id => document.querySelector(`.toc-link[data-slug="${id}"]`))
                    .filter(l => l && l.offsetParent !== null);

                if (!body || !indicator) return;
                if (links.length === 0) {
                    indicator.style.opacity = '0';
                    return;
                }

                const bodyRect = body.getBoundingClientRect();
                const rects = links.map(l => l.getBoundingClientRect());
                const top = Math.min(...rects.map(r => r.top)) - bodyRect.top;
                const bottom = Math.max(...rects.map(r => r.bottom)) - bodyRect.top;
                indicator.style.top = `${top}px`;
                indicator.style.height = `${bottom - top}px`;
                indicator.style.opacity = '1';

                // Scroll ToC to keep the start of the range visible (only when the
                // range actually moved — not on every scroll tick)
                if (!keyChanged) return;
                const link = links[0];
                const nav = link.closest('.toc-nav');
                if (nav) {
                    const title = nav.querySelector('.toc-title');
                    const titleHeight = title ? title.offsetHeight : 0;
                    const linkTop = link.offsetTop;
                    const linkBottom = linkTop + link.offsetHeight;
                    const navScrollTop = nav.scrollTop;
                    const navHeight = nav.clientHeight;
                    if (linkTop < navScrollTop + titleHeight) {
                        nav.scrollTo({ top: linkTop - titleHeight, behavior: 'smooth' });
                    } else if (linkBottom > navScrollTop + navHeight) {
                        nav.scrollTo({ top: linkBottom - navHeight, behavior: 'smooth' });
                    }
                }
            }

            // Find which sections are currently on screen
            function updateActiveHeading() {
                // Don't update if we're scrolling from a click
                if (isScrollingFromClick) return;

                const headerOffset = 120; // Reading position under the sticky header
                const scrollY = window.scrollY;
                const windowHeight = window.innerHeight;
                const documentHeight = document.documentElement.scrollHeight;

                const currentHeadings = visibleHeadings();
                if (currentHeadings.length === 0) return;

                // A heading's section runs from its top to the next visible heading's top.
                // Collect every section that intersects the reading window.
                const tops = currentHeadings.map(h => h.getBoundingClientRect().top);
                const ids = [];
                for (let i = 0; i < currentHeadings.length; i++) {
                    const secTop = tops[i];
                    const secBottom = i + 1 < tops.length ? tops[i + 1] : documentHeight - scrollY;
                    // Section still on screen below the header, and started above the fold
                    if (secBottom > headerOffset && secTop < windowHeight - 40) {
                        const id = currentHeadings[i].getAttribute('id');
                        if (id) ids.push(id);
                    }
                }

                // Above the first heading (intro) — point at the first section
                if (ids.length === 0) {
                    const firstId = currentHeadings[0].getAttribute('id');
                    if (firstId) ids.push(firstId);
                }

                // At the very bottom, make sure the last section is included even if
                // it's too short to cross the reading offset
                if (scrollY + windowHeight >= documentHeight - 50) {
                    const lastId = currentHeadings[currentHeadings.length - 1].getAttribute('id');
                    if (lastId && !ids.includes(lastId)) ids.push(lastId);
                }

                setActiveRange(ids);
            }
            
            // Update on scroll with throttling
            let ticking = false;
            let scrollEndTimer;

            // SDK-version blocks hide their content via `display: none` on the
            // wrapping `[data-sdk-version]` div. Headings inside a hidden block
            // have offsetParent === null — skip them so scrollspy never lands on
            // a heading the user can't see.
            const visibleHeadings = () => headings.filter(h => h.offsetParent !== null);

            const handleScroll = () => {
                // If we are in "click mode", we purely want to detect when scrolling STOPS
                // We don't want to run the expensive/noisy update logic during the smooth scroll
                if (isScrollingFromClick) {
                    clearTimeout(scrollEndTimer);
                    scrollEndTimer = setTimeout(() => {
                        isScrollingFromClick = false;
                        updateActiveHeading();
                    }, 100); // Wait for scroll to settle
                    return;
                }
            
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        updateActiveHeading();
                        ticking = false;
                    });
                    ticking = true;
                }
            };
            
            window.addEventListener('scroll', handleScroll, { passive: true });

            // Re-sync when the viewport changes (the ToC appears/disappears at xl)
            window.addEventListener('resize', () => {
                currentRangeKey = '';
                updateActiveHeading();
            }, { passive: true });
            
            // Handle direct clicks on TOC links
            document.querySelectorAll('.toc-link').forEach(link => {
                link.addEventListener('click', (e) => {
                    const slug = link.getAttribute('data-slug');
                    if (slug) {
                        // 1. Set Flag
                        isScrollingFromClick = true;

                        // 2. Optimistically update UI
                        setActiveRange([slug]);
                        
                        // 3. Clear any pending auto-updates
                        if (ticking) ticking = false;
                        
                        // 4. Start the "scroll end" watchdog immediately 
                        // (in case the scroll is tiny and doesn't fire many events)
                        clearTimeout(scrollEndTimer);
                        scrollEndTimer = setTimeout(() => {
                            isScrollingFromClick = false;
                            updateActiveHeading();
                        }, 100);
                    }
                });
            });
            
            // Initial update
            updateActiveHeading();
        }
        
        // Run on load and astro navigation
        initTOC();
        document.addEventListener('astro:page-load', initTOC);
    </script>
</nav>

<style>
  .toc-nav {
    width: 100%;
    padding-left: 1.5rem;
    overflow-y: auto;
    /* Smooth scrolling within TOC */
    scroll-behavior: smooth;
    flex: 1;
    min-height: 0;
    scroll-padding-top: 2rem;
  }
  
  /* Custom scrollbar for TOC */
  .toc-nav::-webkit-scrollbar {
    width: 4px;
  }
  
  .toc-nav::-webkit-scrollbar-track {
    background: transparent;
  }
  
  .toc-nav::-webkit-scrollbar-thumb {
    background: var(--border-primary);
    border-radius: 2px;
  }
  
  .toc-nav::-webkit-scrollbar-thumb:hover {
    background: var(--accent-primary);
  }
  
  .toc-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    opacity: 0.8;
    position: sticky;
    top: 0;
    background: var(--bg-primary);
    padding: 0.5rem 0;
    z-index: 10;
  }
  
  /* Rail: a continuous track along the whole list; the indicator segment slides
     and stretches over the sections currently on screen. */
  .toc-body {
    position: relative;
    padding-left: 0.875rem;
  }

  .toc-body::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--border-primary);
  }

  .toc-indicator {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 0;
    border-radius: 2px;
    background: var(--accent-primary);
    opacity: 0;
    transition: top 0.25s ease, height 0.25s ease, opacity 0.2s ease;
    z-index: 1;
  }

  .toc-link {
    display: block;
    font-size: 13px;
    color: var(--text-secondary);
    transition: color 0.2s ease;
    line-clamp: 2;
    font-weight: 500;
    line-height: 1.375;
  }

  .toc-link:hover {
    color: var(--text-primary);
  }

  .toc-link.toc-active {
    color: var(--accent-primary);
  }

  .toc-nav li.toc-tab-hidden {
    display: none;
  }
</style>
