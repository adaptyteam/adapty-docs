---
interface Props {
  tooltip: string;
}

const { tooltip } = Astro.props;
---

<span class="tooltip-container relative group" data-tooltip-wrapper>
  <span class="tooltip-trigger cursor-help relative text-[var(--accent-primary)] font-semibold transition-all duration-200 hover:text-[var(--accent-hover)] decoration-dotted underline underline-offset-4 decoration-[var(--accent-primary)]/30 hover:decoration-[var(--accent-primary)]/80">
    {tooltip}
  </span>
  
  <span class="tooltip-popup fixed left-0 top-0 translate-y-2 w-max max-w-[320px]
              opacity-0 invisible transition-[opacity,transform] duration-200 ease-out z-[9999] pointer-events-none
              group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:pointer-events-auto
              group-[.force-closed]:opacity-0 group-[.force-closed]:invisible group-[.force-closed]:pointer-events-none
              before:absolute before:-bottom-3 before:left-0 before:w-full before:h-4 before:content-['']">
    <span class="tooltip-content block relative bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl shadow-[var(--shadow-lg)] p-4 pr-10 text-sm text-[var(--text-secondary)] leading-relaxed min-w-[200px]">
      <button class="tooltip-close absolute top-2 right-2 p-1 text-[var(--text-tertiary)] hover:text-[var(--text-primary)] transition-colors" aria-label="Close tooltip">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <span class="tooltip-inner block" data-astro-rerun>
        <slot />
      </span>
      <span class="tooltip-arrow absolute top-full -translate-x-1/2 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[6px] border-t-[var(--bg-primary)] after:content-[''] after:absolute after:top-[-7px] after:left-[-6px] after:border-l-[6px] after:border-l-transparent after:border-r-[6px] after:border-r-transparent after:border-t-[6px] after:border-t-[var(--border-primary)] after:-z-10"></span>
    </span>
  </span>
</span>

<script>
  function closeAllTooltips() {
    document.querySelectorAll('[data-tooltip-wrapper][data-open]').forEach(w => {
      w.removeAttribute('data-open');
    });
  }

  const GAP = 8; // space between trigger and popup
  const EDGE = 8; // minimum distance from the viewport edge

  /* The popup is position: fixed so no scrollable ancestor can clip it — tables set
     overflow-x: auto, which forces overflow-y to auto and would otherwise cut it off.
     Fixed positioning means the coordinates have to be computed here. */
  function positionTooltip(wrapper) {
    const trigger = wrapper.querySelector('.tooltip-trigger');
    const popup = wrapper.querySelector('.tooltip-popup');
    const arrow = wrapper.querySelector('.tooltip-arrow');
    if (!trigger || !popup) return;

    const t = trigger.getBoundingClientRect();
    const width = popup.offsetWidth;
    const height = popup.offsetHeight;

    let left = t.left + t.width / 2 - width / 2;
    left = Math.max(EDGE, Math.min(left, window.innerWidth - width - EDGE));

    // Prefer above the trigger; flip below when there isn't room.
    const below = t.top - height - GAP < EDGE;
    const top = below ? t.bottom + GAP : t.top - height - GAP;

    popup.style.left = left + 'px';
    popup.style.top = top + 'px';
    wrapper.classList.toggle('tooltip-below', below);

    // Keep the arrow pointing at the trigger even when the popup is clamped.
    if (arrow) {
      const centre = t.left + t.width / 2 - left;
      arrow.style.left = Math.max(14, Math.min(centre, width - 14)) + 'px';
    }
  }

  function repositionVisible() {
    document.querySelectorAll('[data-tooltip-wrapper]').forEach(wrapper => {
      if (wrapper.hasAttribute('data-open') || wrapper.matches(':hover')) {
        positionTooltip(wrapper);
      }
    });
  }

  function initTooltips() {
    closeAllTooltips();
    const wrappers = document.querySelectorAll('[data-tooltip-wrapper]');

    wrappers.forEach(wrapper => {
      // Avoid double initialization
      if (wrapper.getAttribute('data-tooltip-initialized')) return;
      wrapper.setAttribute('data-tooltip-initialized', 'true');

      const closeBtn = wrapper.querySelector('.tooltip-close');
      const trigger = wrapper.querySelector('.tooltip-trigger');
      const popup = wrapper.querySelector('.tooltip-popup');

      if (!closeBtn || !trigger || !popup) return;

      // Handle Close Button (Force Close)
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        wrapper.removeAttribute('data-open');
        // data-open is removed first — the two states never coexist
        wrapper.classList.add('force-closed');
      });

      // Position before the CSS hover state reveals it
      wrapper.addEventListener('mouseenter', () => positionTooltip(wrapper));
      trigger.addEventListener('focus', () => positionTooltip(wrapper));

      // Reset force-closed state when mouse leaves the wrapper
      wrapper.addEventListener('mouseleave', () => {
        wrapper.classList.remove('force-closed');
      });

      // Tap/click trigger to toggle tooltip (mobile + desktop)
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = wrapper.hasAttribute('data-open');
        closeAllTooltips();
        if (!isOpen) {
          wrapper.setAttribute('data-open', '');
          wrapper.classList.remove('force-closed');
          positionTooltip(wrapper);
        }
      });

      // Clicks inside the popup don't bubble to document (so links work)
      popup.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    });
  }

  if (!window.__tooltipDocListenerAttached) {
    window.__tooltipDocListenerAttached = true;
    document.addEventListener('click', () => closeAllTooltips());
    document.addEventListener('astro:page-load', initTooltips);
    // Fixed coordinates go stale on any scroll, including inside a scrollable table
    window.addEventListener('scroll', repositionVisible, true);
    window.addEventListener('resize', repositionVisible);
  }
  initTooltips();
</script>

<style>
  .tooltip-container {
    display: inline !important;
    vertical-align: baseline;
    line-height: inherit;
  }
  
  .tooltip-trigger {
    display: inline;
    line-height: 1.6;
    vertical-align: baseline;
    touch-action: manipulation;
  }
  
  .tooltip-popup {
    line-height: 1.6;
  }

  /* Show tooltip via JS (mobile tap) */
  [data-tooltip-wrapper][data-open] .tooltip-popup {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Flipped below the trigger: the hover bridge and the arrow move to the top edge */
  .tooltip-below .tooltip-popup::before {
    bottom: auto;
    top: -12px;
  }

  .tooltip-below .tooltip-arrow {
    top: auto;
    bottom: 100%;
    border-top-color: transparent;
    border-bottom: 6px solid var(--bg-primary);
  }

  .tooltip-below .tooltip-arrow::after {
    top: auto;
    bottom: -7px;
    border-top-color: transparent;
    border-bottom: 6px solid var(--border-primary);
  }

  /* Custom typography for tooltip content */
  .tooltip-inner :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
  
  .tooltip-inner :global(a) {
    color: var(--accent-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  
  .tooltip-inner :global(a:hover) {
    color: var(--accent-hover);
  }

  .tooltip-inner :global(code) {
    font-size: 0.8125rem;
    padding: 0.125rem 0.375rem;
    background: var(--bg-hover);
    border: 1px solid var(--border-primary);
    border-radius: 0.375rem;
    color: var(--accent-primary);
    font-weight: 600;
  }
</style>
