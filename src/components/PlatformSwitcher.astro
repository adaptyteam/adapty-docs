---
import platformsData from '../data/platforms.json';
import { getPlatformSwitchLinks } from '../utils/platform-switch';

interface Props {
  currentPlatformId: string;
  currentActiveId: string;
  currentLocale?: string;
}

const { currentPlatformId, currentActiveId, currentLocale } = Astro.props;
const { sdkPlatforms } = platformsData;

const currentPlatform = sdkPlatforms.find((p) => p.id === currentPlatformId);
const links = getPlatformSwitchLinks(currentPlatformId, currentActiveId, currentLocale);
---

<div class="platform-switcher-container">
  <button 
    class="platform-switcher-trigger"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <span class="flex items-center gap-2 truncate">
      <div class="platform-indicator"></div>
      {currentPlatform?.label || 'Select Platform'}
    </span>
    <svg class="platform-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div class="platform-switcher-menu">
    <div class="platform-switcher-content">
        <div class="platform-switcher-label">SDK Platforms</div>
      {sdkPlatforms.map((platform) => (
        <a
          href={links[platform.id]}
          data-platform-id={platform.id}
          class:list={[
            "platform-switcher-item",
            currentPlatformId === platform.id && "platform-switcher-item-active"
          ]}
        >
          {platform.label}
          {currentPlatformId === platform.id && (
             <svg class="ml-auto w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
             </svg>
          )}
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .platform-switcher-container {
    position: relative;
    z-index: 20;
  }
  
  .platform-switcher-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 0.75rem;
    transition: all 0.3s;
    width: 100%;
    justify-content: space-between;
    cursor: pointer;
  }

  .platform-switcher-trigger:hover {
    color: var(--text-primary);
    border-color: var(--accent-primary);
  }
  
  .platform-indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--accent-primary);
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
  
  .platform-chevron {
    width: 1rem;
    height: 1rem;
    color: var(--text-tertiary);
    flex-shrink: 0;
    transition: transform 0.3s, color 0.3s;
  }
  
  .platform-switcher-container:hover .platform-chevron {
    color: var(--text-primary);
    transform: rotate(180deg);
  }
  
  .platform-switcher-menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 0.5rem;
    width: 14rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    transition: all 0.2s;
    overflow: hidden;
    z-index: 50;
  }
  
  .platform-switcher-container:hover .platform-switcher-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  
  .platform-switcher-content {
    padding: 0.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  
  .platform-switcher-label {
    padding: 0.5rem 0.75rem;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
  }
  
  .platform-switcher-item {
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    font-size: 13px;
    border-radius: 6px;
    transition: all 0.2s;
    color: var(--text-secondary);
    font-weight: 500;
    text-decoration: none;
    border: none;
    background: transparent;
    cursor: pointer;
    width: 100%;
    text-align: left;
  }
  
  .platform-switcher-item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }
  
  .platform-switcher-item-active {
    background: color-mix(in srgb, var(--accent-primary) 8%, transparent);
    color: var(--accent-primary);
    font-weight: 600;
  }
  
  .platform-switcher-item-active svg {
    color: var(--accent-primary);
  }
</style>

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

  // The sidebar is transition:persist per platform, so navigating within a
  // platform keeps this switcher and drops the new page's copy, whose links
  // were computed for the new page. Carry those links over before the swap.
  document.addEventListener('astro:before-swap', (event) => {
    const { newDocument } = event as TransitionBeforeSwapEvent;
    newDocument.querySelectorAll<HTMLAnchorElement>('.platform-switcher-item[data-platform-id]').forEach((fresh) => {
      const kept = document.querySelector<HTMLAnchorElement>(
        `.platform-switcher-item[data-platform-id="${fresh.dataset.platformId}"]`,
      );
      if (kept) kept.setAttribute('href', fresh.getAttribute('href') ?? '');
    });
  });
</script>
