---
interface Props {
  item: any;
  activeId: string;
  depth?: number;
}

const { item, activeId, depth = 0 } = Astro.props;

const isCategory = item.type === 'category';

// Use href provided by Sidebar.astro (which already handles base URL)
const getHref = (item: any) => {
  return item.href || null;
};

const itemHref = getHref(item);
const isActive = (item.id && item.id === activeId) || (item.link?.id && item.link.id === activeId);

function hasActiveChild(node: any, targetId: string): boolean {
    if (node.id === targetId || node.link?.id === targetId) return true;
    if (node.items) {
        return node.items.some((child: any) => hasActiveChild(child, targetId));
    }
    return false;
}

const isChildActive = isCategory && item.items ? hasActiveChild(item, activeId) : false;
// noToggle = static "always-open" group with no chevron (used by the API sidebar).
const noToggle = item.noToggle === true;
// Default: open if noToggle, explicitly set to collapsed: false, or has active child
// (only on first load). After first load, state is managed by user interactions.
const defaultOpen = noToggle || (item.collapsed === false) || isChildActive;

// Indentation: a fixed left padding plus 8px per level
const paddingLeft = 12 + depth * 8;

// Top-level items are 14px, nested ones 13px; all weights are 500. Hierarchy
// comes from size and color (primary vs secondary). The global style block at
// the end of this file styles these class names.
const sizeClass = depth === 0 ? 'sidebar-top' : undefined;
const textColor = isActive ? 'sidebar-item-active' : depth === 0 ? 'sidebar-item-primary' : 'sidebar-item-secondary';
---

<li class="sidebar-li">
  {item.isOverview && !isCategory ? (
    <a
      href={itemHref || '#'}
      class:list={['sidebar-overview', sizeClass, isActive && 'sidebar-overview-active']}
      style={`padding-left: ${paddingLeft}px`}
      id={isActive ? 'active-sidebar-item' : undefined}
      data-sidebar-link
      data-href={itemHref}
      data-sidebar-overview-link
    >{item.label}</a>
  ) : isCategory ? (
    <div class="category-wrapper">
      <div
        class:list={[
          'sidebar-row', sizeClass, textColor,
          isActive ? 'sidebar-item-bg-active' : (noToggle && !itemHref) ? undefined : 'sidebar-item-hover',
        ]}
        style={`padding-left: ${paddingLeft}px`}
        id={isActive ? 'active-sidebar-item' : undefined}
        data-sidebar-container
      >
        {itemHref ? (
          <a href={itemHref} class:list={['category-title-link', sizeClass, textColor]} data-sidebar-link data-href={itemHref}>{item.label}</a>
        ) : noToggle ? (
          <div class:list={['sidebar-row-label', sizeClass, textColor]}>{item.label}</div>
        ) : (
          <button class:list={['category-title-link', sizeClass, textColor]}>{item.label}</button>
        )}
        {!noToggle && (
          <div class="sidebar-toggle-wrap">
            <button class="category-toggle sidebar-toggle-btn" aria-label="Toggle category">
              <svg class="sidebar-chevron" aria-hidden="true"><use href="#sidebar-chevron" /></svg>
            </button>
          </div>
        )}
      </div>
      <div class:list={['category-items-container', defaultOpen && 'expanded']}>
        <div class="category-items-content">
          <ul class="sidebar-sublist sidebar-category-border">
            {item.items.map((child: any) => (
              <Astro.self item={child} activeId={activeId} depth={depth + 1} />
            ))}
          </ul>
        </div>
      </div>
    </div>
  ) : (
    <a
      href={itemHref || '#'}
      class:list={['sidebar-link', sizeClass, textColor, isActive ? 'sidebar-item-bg-active' : 'sidebar-item-hover']}
      style={`padding-left: ${paddingLeft}px`}
      id={isActive ? 'active-sidebar-item' : undefined}
      data-sidebar-link
      data-href={itemHref}
      data-sidebar-container
    >{item.label}</a>
  )}
</li>

<style is:global>
  .sidebar-item-active,
  .sidebar-item-active:visited,
  .sidebar-tree .sidebar-item-active .category-title-link,
  .sidebar-tree .sidebar-item-active .category-title-link:visited {
    color: var(--accent-primary) !important;
    /* Removed font-weight change to prevent layout shift/wrapping */
  }
  
  .sidebar-item-primary,
  .sidebar-item-primary:visited {
    color: var(--text-primary) !important;
  }
  
  .sidebar-item-secondary,
  .sidebar-item-secondary:visited {
    color: var(--text-secondary) !important;
  }
  
  .sidebar-item-bg-active {
    background: transparent;
    border-color: var(--accent-primary) !important;
    /* Removed font-weight change */
  }
  
  .sidebar-item-hover:hover {
    background: var(--bg-hover);
    color: var(--text-primary) !important;
  }
  
  .sidebar-tree .sidebar-item-hover:hover .category-title-link {
    color: var(--text-primary) !important;
  }
  
  /* Removed .sidebar-indicator styles as it's no longer used */
  
  .sidebar-toggle-btn:hover {
    background: var(--bg-hover);
  }
  
  .sidebar-chevron {
    color: var(--text-tertiary);
  }
  
  .sidebar-category-border {
    border-left: 1px solid var(--border-primary);
  }

  /* Overview link — the spec landing page entry. A soft neutral card with a
     hairline border so it reads as a clickable section "home" at rest, not
     just a tinted patch of background. Active state deepens both surfaces. */
  .sidebar-overview {
    background: var(--bg-secondary);
    color: var(--text-primary) !important;
    text-decoration: none;
    border: 1px solid var(--border-primary);
  }
  .sidebar-overview:visited {
    color: var(--text-primary) !important;
  }
  .sidebar-overview:hover {
    background: var(--bg-hover);
    border-color: var(--border-secondary);
  }
  .sidebar-overview-active {
    background: var(--bg-hover) !important;
    color: var(--text-primary) !important;
    border-color: color-mix(in srgb, var(--accent-primary) 40%, transparent) !important;
  }

  /* Desktop tree (Sidebar.astro). Global rather than scoped: a scoped block
     makes Astro stamp a data-astro-cid attribute on every element of the ~450
     items. Prefixed with .sidebar-tree so the mobile menu, which reuses some
     class names with its own rules, is unaffected. */
  .sidebar-tree .sidebar-li {
    position: relative;
    width: 100%;
  }

  .sidebar-tree .sidebar-row,
  .sidebar-tree .sidebar-link {
    display: flex;
    align-items: center;
    width: 100%;
    padding-top: 0.375rem;
    padding-bottom: 0.375rem;
    border-left: 3px solid transparent;
    font-size: 13px;
    font-weight: 500;
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-tree .sidebar-row {
    justify-content: space-between;
    padding-right: 0.75rem;
  }

  .sidebar-tree .sidebar-link {
    padding-right: 1rem;
  }

  .sidebar-tree .category-title-link,
  .sidebar-tree .sidebar-row-label {
    flex: 1;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
  }

  .sidebar-tree .category-title-link {
    text-decoration: none;
    outline: none;
    cursor: pointer;
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-tree .sidebar-top {
    font-size: 14px;
  }

  .sidebar-tree .category-wrapper {
    margin-bottom: 0.125rem;
  }

  .sidebar-tree .sidebar-toggle-wrap {
    display: flex;
    align-items: center;
  }

  .sidebar-tree .category-toggle {
    color: inherit;
    padding: 0.25rem;
    margin-right: -0.25rem;
    border-radius: 0.5rem;
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-tree .sidebar-chevron {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-tree .sidebar-sublist {
    margin: 0.25rem 0 0.375rem 14px;
  }

  .sidebar-tree .sidebar-sublist > :not(:last-child) {
    margin-bottom: 0.25rem;
  }

  .sidebar-tree .sidebar-overview {
    display: flex;
    align-items: center;
    padding-top: 0.375rem;
    padding-bottom: 0.375rem;
    padding-right: 12px;
    margin: 0.25rem 8px 0.25rem 0;
    border-radius: 0.375rem;
    font-size: 13px;
    font-weight: 500;
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-tree .category-items-container {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-tree .category-items-container.expanded {
    grid-template-rows: 1fr;
  }

  .sidebar-tree .category-items-content {
    overflow: hidden;
    min-height: 0;
  }
</style>

<script>
  function initSidebar() {
    const toggleButtons = document.querySelectorAll('.category-toggle');
    const titleLinks = document.querySelectorAll('.category-title-link');
    
    toggleButtons.forEach(button => {
      const wrapper = button.closest('.category-wrapper');
      const itemsList = wrapper ? wrapper.querySelector('.category-items-container') : null;
      const svg = button.querySelector('svg');
      
      if (!itemsList || !svg) return;
      
      // Sync SVG rotation with current expansion state
      if (itemsList.classList.contains('expanded')) {
        svg.style.transform = 'rotate(90deg)';
      } else {
        svg.style.transform = 'rotate(0deg)';
      }
      
      // Check if listener already exists
      if (button.hasAttribute('data-listener-added')) return;
      button.setAttribute('data-listener-added', 'true');
      
      button.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        // Simple toggle
        const isCurrentlyExpanded = itemsList.classList.contains('expanded');
        itemsList.classList.toggle('expanded');
        svg.style.transform = isCurrentlyExpanded ? 'rotate(0deg)' : 'rotate(90deg)';
      });
    });
    
    // Handle category title clicks
    titleLinks.forEach(link => {
      if (link.hasAttribute('data-listener-added')) return;
      link.setAttribute('data-listener-added', 'true');

      const isNavLink = link.tagName === 'A';

      link.addEventListener('click', (e) => {
        const wrapper = link.closest('.category-wrapper');
        const itemsList = wrapper ? wrapper.querySelector('.category-items-container') : null;
        const toggleButton = wrapper ? wrapper.querySelector('.category-toggle') : null;
        const svg = toggleButton?.querySelector('svg');
        
        if (!itemsList || !svg) return;
        
        const isCurrentlyExpanded = itemsList.classList.contains('expanded');
        
        // For navigation links: always expand if collapsed, then let navigation happen
        if (isNavLink) {
          if (!isCurrentlyExpanded) {
            // Expand the category (don't prevent default - let navigation happen)
            itemsList.classList.add('expanded');
            svg.style.transform = 'rotate(90deg)';
          }
          // Always allow navigation
        } 
        // For buttons: always toggle
        else {
          e.preventDefault();
          itemsList.classList.toggle('expanded');
          svg.style.transform = isCurrentlyExpanded ? 'rotate(0deg)' : 'rotate(90deg)';
        }
      });
    });
  }

  // Run on initial load
  initSidebar();

  // Run on every page navigation (sidebar persists but we need to update listeners for any new content)
  document.addEventListener('astro:page-load', initSidebar);
</script>
