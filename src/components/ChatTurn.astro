---
// One turn inside <AgentChat>. Roles:
//   user    — what the developer typed
//   agent   — the agent's reply, written as markdown
//   tool    — commands the agent ran, one list item each; collapsed,
//             `summary` is the visible line
//   confirm — a write the agent waits on, drawn as a permission prompt:
//             `summary` is its title, the children are the question and a
//             numbered list of options (the first one shows as selected)
//
// Slotted markdown renders in the article's scope, so rules that target it
// need `:global()`. The article's list styles (step-number circles) are
// overridden with !important because their selectors outrank scoped ones.
interface Props {
  role: 'user' | 'agent' | 'tool' | 'confirm';
  summary?: string;
}

const { role, summary } = Astro.props;
---

{role === 'user' && (
  <div class="turn turn-user">
    <span class="turn-marker" aria-hidden="true">&gt;</span>
    <div class="turn-content"><slot /></div>
  </div>
)}

{role === 'agent' && (
  <div class="turn turn-agent">
    <span class="turn-marker" aria-hidden="true">⏺</span>
    <div class="turn-content"><slot /></div>
  </div>
)}

{role === 'tool' && (
  <details class="turn turn-tool">
    <summary>
      <span class="turn-marker" aria-hidden="true">⏺</span>
      <span class="turn-summary">{summary ?? 'Ran commands'}<span class="turn-toggle" aria-hidden="true"></span></span>
    </summary>
    <div class="turn-content"><slot /></div>
  </details>
)}

{role === 'confirm' && (
  <div class="turn turn-confirm">
    {summary && <div class="turn-label">{summary}</div>}
    <div class="turn-content"><slot /></div>
  </div>
)}

<style>
  .turn {
    color: var(--text-secondary);
  }

  .turn-user,
  .turn-agent,
  .turn-tool > summary {
    display: grid;
    grid-template-columns: 1.125rem minmax(0, 1fr);
    column-gap: 0.375rem;
  }

  .turn-marker {
    user-select: none;
    color: var(--text-tertiary);
  }

  /* User prompt: the echoed input line */
  .turn-user {
    margin: 0 -0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 4px;
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  .turn-agent .turn-marker {
    color: var(--text-primary);
  }

  /* Tool calls: a green done-dot and one line that opens to the commands */
  .turn-tool > summary {
    cursor: pointer;
    list-style: none;
  }

  .turn-tool > summary::-webkit-details-marker {
    display: none;
  }

  .turn-tool .turn-marker {
    color: #1a9c6d;
  }

  :global(.dark) .turn-tool .turn-marker {
    color: #3ecf8e;
  }

  .turn-summary {
    color: var(--text-primary);
  }

  .turn-toggle::before {
    content: '+';
    margin-left: 0.5rem;
    color: var(--text-tertiary);
  }

  .turn-tool[open] .turn-toggle::before {
    content: '−';
  }

  .turn-tool > summary:hover .turn-toggle::before {
    color: var(--text-secondary);
  }

  .turn-tool .turn-content {
    margin-top: 0.25rem;
    padding-left: 1.5rem;
    color: var(--text-tertiary);
  }

  .turn-tool .turn-content :global(ul) {
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  .turn-tool .turn-content :global(li) {
    position: relative;
    margin: 0 !important;
    padding: 0 0 0 1.25rem !important;
  }

  .turn-tool .turn-content :global(li::before) {
    content: '⎿' !important;
    position: absolute;
    left: 0;
    color: var(--border-secondary);
  }

  .turn-tool .turn-content :global(li::marker) {
    content: none;
  }

  .turn-tool .turn-content :global(code) {
    padding: 0 !important;
    border: none !important;
    background: none !important;
    font-size: inherit !important;
    color: inherit !important;
  }

  /* Permission prompt: a bordered box, options numbered, the first selected */
  .turn-confirm {
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in srgb, var(--accent-primary) 55%, transparent);
    border-radius: 6px;
  }

  .turn-label {
    margin-bottom: 0.375rem;
    font-weight: 600;
    color: var(--accent-hover);
  }

  :global(.dark) .turn-label {
    color: var(--accent-primary);
  }

  .turn-confirm .turn-content :global(ol) {
    margin: 0.5rem 0 0 !important;
    padding: 0 !important;
    list-style: none !important;
    counter-reset: option;
  }

  .turn-confirm .turn-content :global(ol > li) {
    position: relative;
    margin: 0 !important;
    padding: 0 0 0 1.5rem !important;
    color: var(--text-tertiary);
    counter-increment: option;
  }

  .turn-confirm .turn-content :global(ol > li::before) {
    content: counter(option) '.' !important;
    position: static !important;
    display: inline !important;
    width: auto !important;
    height: auto !important;
    margin-right: 0.5rem;
    border-radius: 0 !important;
    background: none !important;
    font-size: inherit !important;
    font-weight: 400 !important;
    color: inherit !important;
  }

  .turn-confirm .turn-content :global(ol > li:first-child) {
    color: var(--accent-hover);
  }

  :global(.dark) .turn-confirm .turn-content :global(ol > li:first-child) {
    color: var(--accent-primary);
  }

  .turn-confirm .turn-content :global(ol > li:first-child::after) {
    content: '❯';
    position: absolute;
    left: 0;
  }

  /* Markdown inside a turn: compact, terminal-like */
  .turn-content :global(> *:first-child) {
    margin-top: 0 !important;
  }

  .turn-content :global(> *:last-child) {
    margin-bottom: 0 !important;
  }

  .turn-content :global(p) {
    margin: 0 0 0.75rem !important;
    font-size: inherit !important;
    line-height: inherit !important;
  }

  .turn-content :global(strong) {
    color: var(--text-primary);
  }

  /* Inline code reads as a highlighted token, not a pill, in a terminal */
  .turn-content :global(code) {
    padding: 0 !important;
    border: none !important;
    background: none !important;
    font-size: inherit !important;
    color: var(--accent-hover) !important;
  }

  :global(.dark) .turn-content :global(code) {
    color: var(--accent-primary) !important;
  }

  .turn-agent .turn-content :global(ul),
  .turn-agent .turn-content :global(ol) {
    margin: 0 0 0.75rem !important;
    padding: 0 !important;
    list-style: none !important;
    counter-reset: step;
  }

  .turn-agent .turn-content :global(li) {
    position: relative;
    margin: 0 !important;
    padding: 0 0 0 1.25rem !important;
    font-size: inherit !important;
    line-height: inherit !important;
  }

  .turn-agent .turn-content :global(ul > li::before) {
    content: '-' !important;
    position: absolute;
    left: 0;
    color: var(--text-tertiary);
  }

  .turn-agent .turn-content :global(li::marker) {
    content: none;
  }

  .turn-agent .turn-content :global(ol > li) {
    counter-increment: step;
  }

  .turn-agent .turn-content :global(ol > li::before) {
    content: counter(step) '.' !important;
    position: absolute !important;
    left: 0 !important;
    top: 0 !important;
    width: auto !important;
    height: auto !important;
    display: inline !important;
    border-radius: 0 !important;
    background: none !important;
    font-size: inherit !important;
    font-weight: 400 !important;
    color: var(--text-tertiary) !important;
  }
</style>
