---
import { SUPPORTED_LOCALES } from "../data/locales";

// Renders its content only on the listed locales' pages, e.g.
// <LocaleOnly locales={['zh']}>…</LocaleOnly> shows on /docs/zh/… and nowhere else.
// List 'en' to include the English page. The markdown/llms exports apply the
// same rule in stripContent() of generate-md.mjs and generate-platform-llms-full.mjs.
interface Props {
    locales: string[];
}

const { locales } = Astro.props;

// Detect locale from the URL (/docs/{locale}/... on localized pages); English otherwise.
const segments = Astro.url.pathname.split("/").filter(Boolean);
const locale =
    segments.find((s) => (SUPPORTED_LOCALES as readonly string[]).includes(s)) ?? "en";
---
{locales.includes(locale) && <slot />}
