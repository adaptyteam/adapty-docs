---
// The single collapsible implementation for articles.
//
// `mdxComponents` maps both `Details` and the lowercase `details` element here,
// so all three shapes articles use today render through this component:
//
//   <Details summary="Title">…</Details>      — title as a prop
//   <Details><summary>Title</summary>…        — title as a child
//   <details><summary>Title</summary>…        — plain HTML, mapped by MDX
//
// The title therefore arrives either as the `summary` prop or as a slotted
// <summary> child. Slotted content is rendered in the *parent's* scope, so
// every rule below that targets it needs `:global()`.
interface Props {
  summary?: string;
  defaultOpen?: boolean;
}

const { summary, defaultOpen = false } = Astro.props;
---

<details class="details-component" open={defaultOpen}>
  {summary && <summary>{summary}</summary>}
  <slot />
</details>

<style>
  .details-component {
    margin: 1.5rem 0;
    border-radius: 0.5rem;
    border: 1px solid var(--border-primary);
    background: var(--bg-primary);
    overflow: visible;
    transition: all 0.2s ease;
  }

  .details-component:hover {
    border-color: var(--border-secondary);
    box-shadow: var(--shadow-sm);
  }

  /* Summary bar */
  .details-component > :global(summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    margin: 0;
    cursor: pointer;
    user-select: none;
    list-style: none;
    background: var(--bg-secondary);
    border-radius: calc(0.5rem - 1px);
    transition: all 0.2s ease;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    position: relative;
  }

  .details-component > :global(summary::-webkit-details-marker) {
    display: none;
  }

  .details-component > :global(summary:hover) {
    background: var(--bg-hover);
  }

  /* Open: the summary stays a tinted header bar, divided from the content */
  .details-component[open] > :global(summary) {
    border-radius: calc(0.5rem - 1px) calc(0.5rem - 1px) 0 0;
    border-bottom: 1px solid var(--border-primary);
  }

  /* Chevron — currentColor through a mask, so it follows the summary text
     color in both themes instead of being a hardcoded grey SVG. */
  .details-component > :global(summary::after) {
    content: '';
    width: 16px;
    height: 16px;
    min-width: 16px;
    flex-shrink: 0;
    display: inline-block;
    margin-left: 0.5rem;
    background-color: currentColor;
    -webkit-mask-image: url("data:image/svg+xml,%3Csvg width='16' height='16' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4 6L8 10L12 6' stroke='%23000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    mask-image: url("data:image/svg+xml,%3Csvg width='16' height='16' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4 6L8 10L12 6' stroke='%23000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .details-component[open] > :global(summary::after) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .details-component,
    .details-component > :global(summary),
    .details-component > :global(summary::after) {
      transition: none;
    }
  }

  /* Content area. Lists carry their own padding below, for the circular
     step numbers the prose styles give ordered lists. */
  .details-component > :global(*:not(summary):not(ol):not(ul)) {
    padding: 1.25rem !important;
    margin: 0 !important;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.7;
    animation: slideDownDetails 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .details-component > :global(ol),
  .details-component > :global(ul) {
    padding: 0.5rem 1.25rem 1.25rem 1.25rem !important;
    margin: 0 !important;
    animation: slideDownDetails 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .details-component > :global(ol) {
    list-style: none !important;
  }

  @keyframes slideDownDetails {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .details-component > :global(*:not(summary)) {
      animation: none;
    }
  }

  /* Typography inside the content area */
  .details-component :global(p) {
    margin: 0 !important;
    padding: 0 !important;
  }

  .details-component :global(p + p) {
    margin-top: 0.75rem !important;
  }

  /* The prose defaults give tables 2em vertical margins, but the content
     area already carries its own padding. */
  .details-component :global(table) {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  .details-component :global(ul > li) {
    margin: 0.25rem 0 !important;
    padding: 0 0 0 1.5rem !important;
  }

  /* Ordered items need the left padding the circular numbers sit in. */
  .details-component :global(ol > li) {
    margin: 0 0 1rem 0 !important;
    padding: 0 0 0 2.25rem !important;
    position: relative !important;
  }

  .details-component :global(li a) {
    color: var(--accent-primary);
  }

  .details-component :global(strong) {
    color: var(--text-primary) !important;
    font-weight: 600 !important;
  }

  .details-component :global(.code-block-wrapper) {
    margin: 0 !important;
    padding: 0 !important;
  }

  .details-component :global(pre) {
    margin: 0 !important;
  }

  .details-component :global(:not(pre) > code) {
    font-size: 0.875rem;
    padding: 0.125rem 0.375rem;
    margin: 0;
    border: none;
    background: var(--bg-tertiary);
    border-radius: 0.375rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
</style>
