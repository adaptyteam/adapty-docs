---
/**
 * "SDK v4+ / SDK v3" switcher for articles that wrap their content in <SDKv4>
 * and <SDKv3> blocks. Rendered at build time, so the page has its final shape
 * before any script runs: the v4 block shows by default, and a reader who chose
 * v3 gets `html.sdk-active-v3` from an inline script in DocsLayout's <head>
 * before the first paint. The CSS that switches blocks and buttons lives in
 * global.css ("SDK Version Tabs").
 */
interface Props {
  /** The article's MDX source; the bar renders only when it has version blocks. */
  body?: string;
}

const { body = '' } = Astro.props;
const hasVersions = /<SDKv[34]\b/.test(body);
---

{hasVersions && (
  <div class="sdk-version-tabs" role="tablist">
    <button type="button" class="sdk-version-tab" data-tab="v4" role="tab">SDK v4+</button>
    <button type="button" class="sdk-version-tab" data-tab="v3" role="tab">SDK v3</button>
  </div>
)}

<script>
  const SDK_VERSION_KEY = 'adapty-sdk-version-tab';

  function activate(tab: 'v4' | 'v3') {
    document.documentElement.classList.toggle('sdk-active-v3', tab === 'v3');
    try { localStorage.setItem(SDK_VERSION_KEY, tab); } catch { /* storage blocked */ }
  }

  // Tag TOC entries with the version their heading belongs to, so CSS can hide
  // the inactive version's entries.
  function tagTocEntries() {
    document.querySelectorAll<HTMLElement>('.toc-link').forEach((link) => {
      const slug = link.getAttribute('data-slug');
      const heading = slug ? document.getElementById(slug) : null;
      const version = heading?.closest('[data-sdk-version]')?.getAttribute('data-sdk-version');
      if (version === 'v3' || version === 'v4') link.closest('li')?.classList.add(`toc-sdk-${version}`);
    });
  }

  document.addEventListener('click', (e) => {
    const button = (e.target as Element | null)?.closest?.<HTMLElement>('.sdk-version-tab');
    const tab = button?.dataset.tab;
    if (tab === 'v4' || tab === 'v3') activate(tab);
  });

  // The root class lives on <html>, which client-side navigation replaces;
  // carry it over so the next page doesn't flash the wrong version.
  document.addEventListener('astro:before-swap', (e) => {
    if (document.documentElement.classList.contains('sdk-active-v3')) {
      (e as Event & { newDocument: Document }).newDocument.documentElement.classList.add('sdk-active-v3');
    }
  });

  // Fires on the first load too
  document.addEventListener('astro:page-load', tagTocEntries);
</script>
