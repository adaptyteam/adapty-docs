---
import { findTabPanels, showPanel } from '../utils/tab-items';

interface Props {
  groupId?: string;
  queryString?: boolean;
}

const { groupId, queryString } = Astro.props;

// The buttons and the starting panel are rendered here, at build time, so the
// group shows in its final shape before any script runs (no layout shift, and
// it reads without JS). The starting panel is the `default` one, else the first.
// A saved choice or a ?query value is applied by the inline script below,
// before the group is painted.
const panelsHtml = await Astro.slots.render('default');
const panels = findTabPanels(panelsHtml);
const initial = panels.find((p) => p.isDefault) ?? panels[0];
const content = initial ? showPanel(panelsHtml, initial.start) : panelsHtml;
const hasDefault = panels.some((p) => p.isDefault);
---

<div
  class="tabs-container my-8"
  data-group-id={groupId}
  data-query-string={queryString ? 'true' : undefined}
  data-has-default={hasDefault ? 'true' : undefined}
>
  <div class="tabs-card">
    <div class="tabs-header" role="tablist">
      {panels.map((panel) => (
        <button
          type="button"
          role="tab"
          class:list={['tab-button', panel === initial ? 'tab-button-active' : 'tab-button-inactive']}
          aria-selected={panel === initial ? 'true' : 'false'}
          data-value={panel.value}
        >{panel.label}</button>
      ))}
    </div>

    <div class="tabs-content px-6 py-5">
      <Fragment set:html={content} />
    </div>
  </div>
  {groupId && (
    <script is:inline>(function(c){const g=c.getAttribute('data-group-id');let v=null;try{if(c.getAttribute('data-query-string')==='true')v=new URLSearchParams(location.search).get(g);if(!v&&!c.hasAttribute('data-has-default'))v=localStorage.getItem('tab-group-'+g)}catch(e){}if(v&&window.__tabsSelect)window.__tabsSelect(c,v)})(document.currentScript.parentElement)</script>
  )}
</div>

<style>
  .tabs-card {
    border-radius: 10px;
    border: 1px solid var(--border-primary);
    background: var(--bg-primary);
    /* No overflow: hidden — it clips absolutely-positioned children that need to
       escape the card (e.g. InlineTooltip popups). The header is transparent now,
       so there's no secondary-background corner to worry about clipping. */
    transition: background-color 0.3s, border-color 0.3s;
  }

  .tabs-header {
    position: relative;
    display: flex;
    gap: 0.5rem;
    /* Top padding keeps labels off the card's top border; bottom stays 0 so the
       active underline sits flush on the header's own border. */
    padding: 0.375rem 0.5rem 0;
    background: transparent;
    border-bottom: 1px solid var(--border-primary);
    overflow-x: auto;
  }

  .tabs-header::-webkit-scrollbar {
    height: 0px;
  }

  .tabs-header {
    scrollbar-width: none;
  }

  /* Tab Button Styling — underline style, matches .sdk-version-tabs */
  :global(.tab-button) {
    position: relative;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: none;
    border: none;
    border-radius: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: all 0.2s;
    white-space: nowrap;
    outline: none;
    cursor: pointer;
  }

  :global(.tab-button-active) {
    background: none;
    color: var(--accent-primary);
    font-weight: 600;
    box-shadow: none;
    border-bottom-color: var(--accent-primary);
  }

  :global(.tab-button-inactive) {
    background: none;
    color: var(--text-secondary);
    font-weight: 500;
  }

  :global(.tab-button-inactive:hover) {
    color: var(--text-primary);
  }

  :global(.tab-button:focus-visible) {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
</style>

<script>
  // Panel switching itself is window.__tabsSelect, defined inline in DocsLayout's
  // <head> so each group's inline script can use it while the page is parsed.
  // This module adds what happens on a click: remember the choice, update the
  // URL, and switch every group with the same groupId (and the TOC, via tab-sync).
  type TabsWindow = Window & { __tabsSelect?: (c: Element, v: string, animate?: boolean) => string | undefined };
  const w = window as TabsWindow;

  document.addEventListener('click', (e) => {
    const button = (e.target as Element | null)?.closest?.<HTMLButtonElement>('.tabs-header > .tab-button');
    const container = button?.closest('.tabs-container');
    if (!button || !container || !w.__tabsSelect) return;
    const value = w.__tabsSelect(container, button.dataset.value ?? '', true);
    const groupId = container.getAttribute('data-group-id');
    if (!value || !groupId) return;

    try { localStorage.setItem(`tab-group-${groupId}`, value); } catch { /* storage blocked */ }
    if (container.getAttribute('data-query-string') === 'true') {
      const url = new URL(window.location.href);
      url.searchParams.set(groupId, value);
      window.history.replaceState(window.history.state, '', url);
    }
    window.dispatchEvent(new CustomEvent('tab-sync', { detail: { groupId, value } }));
  });

  window.addEventListener('tab-sync', (e) => {
    const { groupId, value } = (e as CustomEvent<{ groupId: string; value: string }>).detail;
    document.querySelectorAll(`.tabs-container[data-group-id="${CSS.escape(groupId)}"]`)
      .forEach((container) => w.__tabsSelect?.(container, value));
  });
</script>