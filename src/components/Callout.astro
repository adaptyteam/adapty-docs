---
interface Props {
  type?: string;
  title?: string | false;
}
const { type, title = false } = Astro.props;

const LABELS: Record<string, string> = {
  note: 'Note', tip: 'Tip', info: 'Info', warning: 'Warning',
  danger: 'Danger', important: 'Important', link: '',
};
const kind = type && type in LABELS ? type : 'note';
const label = title || LABELS[kind];
---
<div class={`callout callout-${kind} ${kind === 'link' ? 'singleLineCallout' : ''}`}>
  {label && <div class="callout-label">{label}</div>}
  <div class="callout-content"><slot /></div>
</div>

<style>
.callout {
    position: relative;
    z-index: 5;
    margin: 1.75rem 0;
    padding: 0.875rem 1.125rem;
    border: none;
    border-left: 3px solid color-mix(in srgb, var(--callout-accent) 50%, transparent);
    border-radius: 0 8px 8px 0;
    background: color-mix(in srgb, var(--callout-accent) 5%, var(--bg-primary));
    overflow: auto;
}
:global(.dark) .callout {
    background: color-mix(in srgb, var(--callout-accent) 8%, var(--bg-primary));
}
.callout-label {
    font-size: 0.75rem;
    font-weight: 600;
    /* Labels are 12px text and must hold 4.5:1 on the tint; light mode uses a
       darker shade than the bar/tint accent where the accent alone falls short. */
    color: var(--callout-label, var(--callout-accent));
    margin-bottom: 0.25rem;
}
.callout-content {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-secondary);
}
.callout-content :global(p) { margin: 0; line-height: 1.65; }
.callout-content :global(p + p) { margin-top: 0.5rem; }
.callout-content :global(a) { font-weight: 500; }
.callout-content :global(strong) { color: var(--text-primary); }
.callout :global(.tooltip-popup) { z-index: 99999 !important; }

.callout-note      { --callout-accent: #71717a; --callout-label: #52525b; }
.callout-tip       { --callout-accent: #1a9c6d; --callout-label: #177a56; }
.callout-info      { --callout-accent: #3690cf; --callout-label: #2374ad; }
.callout-warning   { --callout-accent: #c98a04; --callout-label: #8f6508; }
.callout-danger    { --callout-accent: #e5484d; --callout-label: #d13438; }
.callout-important { --callout-accent: #6E56CF; --callout-label: #5B4AAD; }
.callout-link      { --callout-accent: #6E56CF; --callout-label: #5B4AAD; }

/* Dark-mode accents clear 4.5:1 on the dark tints on their own. */
:global(.dark) .callout-note      { --callout-accent: #8b8b93; --callout-label: #8b8b93; }
:global(.dark) .callout-tip       { --callout-accent: #3ecf8e; --callout-label: #3ecf8e; }
:global(.dark) .callout-info      { --callout-accent: #5fb2e8; --callout-label: #5fb2e8; }
:global(.dark) .callout-warning   { --callout-accent: #e2a33c; --callout-label: #e2a33c; }
:global(.dark) .callout-danger    { --callout-accent: #f2727a; --callout-label: #f2727a; }
:global(.dark) .callout-important { --callout-accent: #a79aec; --callout-label: #a79aec; }
:global(.dark) .callout-link      { --callout-accent: #a79aec; --callout-label: #a79aec; }
</style>
